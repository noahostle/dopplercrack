# All services bind to loopback. No Signalglass installation is required.
DOPPLER_PORT=3857
# Optional fixed private API port and secret for another local application.
# Leave blank for an ephemeral port and a random in-memory secret.
DOPPLER_RUNNER_PORT=
DOPPLER_RUNNER_SECRET=
DOPPLER_TIMEOUT_SECONDS=900
DOPPLER_ARCHIVE_MAX_GB=4
DOPPLER_TERRAIN_MAX_TILES=1024
# Public browser key restricted to your local HTTP referrers.
GOOGLE_MAPS_BROWSER_KEY=
